# Local development placeholders only; never use these values in shared environments.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
SESSION_SECRET=
ENVIRONMENT=development
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Configure a real SMTP provider before production password reset flows are enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Private object store; persistent volume, never served by the frontend.
EVIDENCE_STORAGE_DIR=./private-evidence
EVIDENCE_RETENTION_SECONDS=2592000
# Absolute clamscan-compatible executable; required for uploads outside dev/test.
EVIDENCE_SCANNER_PATH=
