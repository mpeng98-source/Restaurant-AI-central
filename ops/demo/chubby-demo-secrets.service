[Unit]
Description=Fetch private demo managed secrets before Docker startup
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/chubby-demo-host.env
ExecStart=/usr/bin/python3 ${DEMO_RELEASE_DIR}/ops/demo/fetch_secrets.py --secret-id ${DEMO_RUNTIME_SECRET_ARN} --region ${AWS_REGION} --directory ${DEMO_SECRETS_DIR}
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
