DEMO_HOST=REPLACE_WITH_ACTUAL_SERVER_AND_TAILNET.ts.net
# The public-IP matcher is not used in the tailnet-only Caddyfile.
# Keep a restrictive placeholder for the base Compose interpolation.
DEMO_ALLOWED_CIDRS=127.0.0.1/32
DEMO_REVISION=REPLACE_WITH_FULL_TESTED_GIT_SHA
DEMO_SECRETS_DIR=/run/chubby-demo-secrets
DEMO_RELEASE_DIR=/opt/chubby-demo/releases/REPLACE_WITH_FULL_TESTED_GIT_SHA
DEMO_RUNTIME_SECRET_ARN=REPLACE_WITH_APPROVED_RUNTIME_SECRET_ARN
AWS_REGION=us-east-1
